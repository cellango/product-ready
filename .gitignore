# Python bytecode and test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Coverage and test output
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml

# Virtual environments
.venv/
venv/
env/
ENV/

# Local environment and secrets
.env
.env.*
!.env.example

# Build and packaging artifacts
build/
dist/
*.egg-info/
*.egg

# Node/npm artifacts used by local lint tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Ansible — vault file must be encrypted before committing.
# If you accidentally decrypt it, keep the plaintext out of git:
infra/inventory/group_vars/vault.yml.plaintext
infra/.vault_pass
*.vault_pass

# Production compose is generated by Ansible on the server, not committed.
docker-compose.prod.yml
