# ── LLM (set at least one) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Slack ─────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# ── Socket Mode (local dev only — remove for production HTTP mode) ────────
# SLACK_APP_TOKEN=xapp-your-app-token

# ── Jira (optional — required for Send to Jira / export features) ─────────
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROD
JIRA_EPIC_TYPE=Epic
JIRA_STORY_TYPE=Story

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# ── Rate limiting ─────────────────────────────────────────────────────────
# Max LLM-triggering requests per user per 60-second window (default: 10).
# RATE_LIMIT_PER_MINUTE=10

# ── Context persistence ───────────────────────────────────────────────────
# Leave unset for in-memory (lost on restart). Set to a path inside the
# /data volume to persist thread history across container restarts and deploys.
# CONTEXT_DB_PATH=/data/context.db
