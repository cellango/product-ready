# Generated by Ansible — do not edit directly on the server.
# Source: infra/roles/product_ready/templates/docker-compose.prod.yml.j2

services:
  product-ready-bot:
    build: .
    env_file: .env
    ports:
      # Bind to loopback only — Nginx proxies external traffic.
      - "127.0.0.1:{{ app_port }}:{{ app_port }}"
    restart: always
    volumes:
      # core/ is baked into the image; mount read-only for live edits.
      - ./core:/app/core:ro
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ app_port }}/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
